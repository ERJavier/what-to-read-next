# =============================================================================
# WhatToRead Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# cp .env.example .env
# 
# NEVER commit your .env file to git!
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# =============================================================================
# Option 1: Use DATABASE_URL directly
# DATABASE_URL=postgresql://user:password@localhost:5432/whattoread

# Option 2: Use individual components (DATABASE_URL will be auto-constructed)
POSTGRES_USER=whattoread
POSTGRES_PASSWORD=your_secure_password_here  # REQUIRED: Change this!
POSTGRES_DB=whattoread
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database connection pool settings (optional)
# DATABASE_POOL_MIN_SIZE=2
# DATABASE_POOL_MAX_SIZE=10

# =============================================================================
# API CONFIGURATION (Optional - defaults shown)
# =============================================================================
# API_HOST=0.0.0.0
# API_PORT=8000

# CORS origins (comma-separated list, or use ["*"] for development)
# For production, specify exact origins: http://localhost:5173,https://yourdomain.com
# CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# =============================================================================
# EMBEDDING MODEL CONFIGURATION (Optional - defaults shown)
# =============================================================================
# EMBEDDING_MODEL=all-MiniLM-L6-v2

# =============================================================================
# SIMILARITY SEARCH CONFIGURATION (Optional - defaults shown)
# =============================================================================
# Similarity threshold (lower = more strict, 0.4 = ~0.6 similarity)
# SIMILARITY_THRESHOLD=0.4
# Maximum number of recommendations to return
# MAX_RECOMMENDATIONS=100

# =============================================================================
# LOGGING CONFIGURATION (Optional - defaults shown)
# =============================================================================
# LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# LOG_FILE=  # Optional path to log file (leave empty for console only)
# DEBUG=false  # Enable debug mode

# =============================================================================
# ETL PIPELINE CONFIGURATION (Optional - defaults shown)
# =============================================================================
# Path to Open Library dump file
# DUMP_FILE=data/ol_dump_works_2025-12-31.txt.gz

# Batch processing settings (tune for your system memory)
# BATCH_SIZE=250  # Number of records to process per batch
# EMBEDDING_BATCH_SIZE=32  # Number of embeddings to generate per batch
# BATCH_DELAY=0.2  # Delay between batches in seconds

# Quality filters
# MIN_SUBJECTS=3  # Minimum number of subjects/tags a book must have
# MAX_RECORDS=0  # Maximum records to process (0 = no limit)
