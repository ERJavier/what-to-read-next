# =============================================================================
# Frontend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# cp .env.example .env
# 
# NEVER commit your .env file to git!
# =============================================================================

# =============================================================================
# API CONFIGURATION (Optional - defaults shown)
# =============================================================================
# API base URL for client-side requests (VITE_ prefix required for Vite)
# VITE_API_URL=http://localhost:8000

# API base URL for server-side requests (used in hooks.server.ts)
# API_URL=http://localhost:8000

# Note: If running the frontend and API separately, set these to match your API URL.
# If using Docker Compose, the default values should work for local development.
